{
  "listeners": [
    {
      "address": "0.0.0.0",
      "port": 8080,
      "https": false
    }
  ],
  "app": {
    "threads_num": 4,
    "document_root": "../web/dist",
    "enable_server_header": true,
    "enable_date_header": true,
    "keepalive_requests": 0,
    "log": {
      "log_path": "",
      "level": "info"
    },
    "custom_config": {
      "data_path": "../data/users.dat",
      "session_timeout_minutes": 30,
      "max_scan_depth": 512
    }
  }
}
